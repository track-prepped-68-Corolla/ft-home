# Environment for the `media` Komodo stack (containers/media.yaml).
#
# `ft komodo-sync` embeds this file as the stack's `environment`, so every
# ${VAR} in the compose resolves. Values here are NOT secret. Real secret
# values live in the Periphery [secrets] block (var/secrets/komodo.yaml, key
# komodo/periphery_secrets); this file only references them by name via [[KEY]].
# See containers/komodo-gitops-setup.md.

# --- IDs / locale (safe defaults; adjust to taste) ---
PUID=1000
PGID=1000
TZ=UTC

# --- Gluetun VPN (NOT secret, but you MUST fill these for your account) ---
# Provider slug, e.g. mullvad, protonvpn, airvpn — see gluetun's wiki.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
# The WireGuard address your provider assigned, e.g. 10.64.0.2/32.
WIREGUARD_ADDRESSES=

# --- Secrets: real values go in komodo/periphery_secrets, never here ---
WIREGUARD_PRIVATE_KEY=[[WIREGUARD_PRIVATE_KEY]]
ARIA2_RPC_SECRET=[[ARIA2_RPC_SECRET]]
