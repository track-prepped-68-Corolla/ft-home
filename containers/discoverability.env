# Environment for the `discoverability` Komodo stack (containers/discoverability.yaml).
# Embedded by `ft komodo-sync`.

# Persistent state root (Caddy certs/config, Homarr appdata) on the host share.
DISCOVERABILITY_ROOT=/srv/host-share/containers/discoverability

# --- Secrets: real values go in komodo/periphery_secrets, never here ---
# Generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=[[HOMARR_SECRET_ENCRYPTION_KEY]]
