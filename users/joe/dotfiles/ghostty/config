theme = Catppuccin Mocha

font-family = "Hack `:Nerd Font"
font-size = 12

# Window Styling
window-padding-x = 4
window-padding-y = 4
window-decoration = client
# Cursor customization
cursor-style = block

# Transparency (0.0 to 1.0)
background-opacity = 0.85

# Blur (Only works on some Compositors/DEs)
background-blur-radius = 20

# Clipboard (OSC 52) — lets remote/SSH sessions write to the local
# clipboard without needing a clipboard tool installed on the remote box
clipboard-read = allow
clipboard-write = allow
